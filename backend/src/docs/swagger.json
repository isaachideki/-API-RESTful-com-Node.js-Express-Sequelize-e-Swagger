{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Adoção Pet",
    "version": "1.0.0",
    "description": "API RESTful para cadastro e consulta de animais disponíveis para adoção. Construída com Node.js, Express, TypeScript e Sequelize (PostgreSQL)."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Servidor da API (mesma origem desta página)"
    }
  ],
  "tags": [
    {
      "name": "Pets",
      "description": "Operações de CRUD dos animais para adoção"
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "summary": "Listar todos os pets",
        "description": "Retorna todos os pets cadastrados, ordenados por id. Aceita filtros opcionais por espécie, porte e situação de adoção.",
        "tags": [
          "Pets"
        ],
        "parameters": [
          {
            "name": "especie",
            "in": "query",
            "required": false,
            "description": "Filtra pela espécie",
            "schema": {
              "type": "string",
              "enum": [
                "cachorro",
                "gato",
                "outro"
              ]
            }
          },
          {
            "name": "porte",
            "in": "query",
            "required": false,
            "description": "Filtra pelo porte",
            "schema": {
              "type": "string",
              "enum": [
                "pequeno",
                "medio",
                "grande"
              ]
            }
          },
          {
            "name": "adotado",
            "in": "query",
            "required": false,
            "description": "Filtra pela situação de adoção",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pets retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "nome": "Thor",
                    "especie": "cachorro",
                    "porte": "grande",
                    "idade_meses": 24,
                    "peso_kg": 28.5,
                    "descricao": "Muito brincalhão e dócil com crianças.",
                    "adotado": false,
                    "createdAt": "2026-10-03T14:30:00.000Z",
                    "updatedAt": "2026-10-03T14:30:00.000Z"
                  }
                ]
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "post": {
        "summary": "Cadastrar um novo pet",
        "description": "Cria um novo registro de pet. Os campos nome, especie, porte e idade_meses são obrigatórios.",
        "tags": [
          "Pets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetDTO"
              },
              "example": {
                "nome": "Thor",
                "especie": "cachorro",
                "porte": "grande",
                "idade_meses": 24,
                "peso_kg": 28.5,
                "descricao": "Muito brincalhão e dócil com crianças."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pet cadastrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                },
                "example": {
                  "id": 1,
                  "nome": "Thor",
                  "especie": "cachorro",
                  "porte": "grande",
                  "idade_meses": 24,
                  "peso_kg": 28.5,
                  "descricao": "Muito brincalhão e dócil com crianças.",
                  "adotado": false,
                  "createdAt": "2026-10-03T14:30:00.000Z",
                  "updatedAt": "2026-10-03T14:30:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "summary": "Buscar pet por ID",
        "description": "Retorna os dados detalhados de um pet específico.",
        "tags": [
          "Pets"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador numérico do pet",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pet encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                },
                "example": {
                  "id": 1,
                  "nome": "Thor",
                  "especie": "cachorro",
                  "porte": "grande",
                  "idade_meses": 24,
                  "peso_kg": 28.5,
                  "descricao": "Muito brincalhão e dócil com crianças.",
                  "adotado": false,
                  "createdAt": "2026-10-03T14:30:00.000Z",
                  "updatedAt": "2026-10-03T14:30:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "put": {
        "summary": "Atualizar um pet",
        "description": "Atualiza os campos enviados no corpo da requisição de um pet existente. Ao menos um campo deve ser informado.",
        "tags": [
          "Pets"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador numérico do pet",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePetDTO"
              },
              "example": {
                "adotado": true,
                "descricao": "Adotado pela família Silva."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                },
                "example": {
                  "id": 1,
                  "nome": "Thor",
                  "especie": "cachorro",
                  "porte": "grande",
                  "idade_meses": 24,
                  "peso_kg": 28.5,
                  "descricao": "Adotado pela família Silva.",
                  "adotado": true,
                  "createdAt": "2026-10-03T14:30:00.000Z",
                  "updatedAt": "2026-10-03T15:10:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "delete": {
        "summary": "Remover um pet",
        "description": "Remove definitivamente o registro de um pet.",
        "tags": [
          "Pets"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador numérico do pet",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Pet removido com sucesso (sem corpo na resposta)"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "maxLength": 100,
            "example": "Thor"
          },
          "especie": {
            "type": "string",
            "enum": [
              "cachorro",
              "gato",
              "outro"
            ],
            "example": "cachorro"
          },
          "porte": {
            "type": "string",
            "enum": [
              "pequeno",
              "medio",
              "grande"
            ],
            "example": "grande"
          },
          "idade_meses": {
            "type": "integer",
            "minimum": 0,
            "example": 24
          },
          "peso_kg": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": 28.5
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "example": "Muito brincalhão e dócil com crianças."
          },
          "adotado": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-03T14:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-03T14:30:00.000Z"
          }
        }
      },
      "CreatePetDTO": {
        "type": "object",
        "required": [
          "nome",
          "especie",
          "porte",
          "idade_meses"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 100,
            "example": "Thor"
          },
          "especie": {
            "type": "string",
            "enum": [
              "cachorro",
              "gato",
              "outro"
            ],
            "example": "cachorro"
          },
          "porte": {
            "type": "string",
            "enum": [
              "pequeno",
              "medio",
              "grande"
            ],
            "example": "grande"
          },
          "idade_meses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600,
            "example": 24
          },
          "peso_kg": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": 28.5
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "example": "Muito brincalhão e dócil com crianças."
          },
          "adotado": {
            "type": "boolean",
            "default": false,
            "example": false
          }
        }
      },
      "UpdatePetDTO": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 100,
            "example": "Thor Júnior"
          },
          "especie": {
            "type": "string",
            "enum": [
              "cachorro",
              "gato",
              "outro"
            ],
            "example": "cachorro"
          },
          "porte": {
            "type": "string",
            "enum": [
              "pequeno",
              "medio",
              "grande"
            ],
            "example": "grande"
          },
          "idade_meses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600,
            "example": 25
          },
          "peso_kg": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "example": 29.0
          },
          "descricao": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "example": "Adotado pela família Silva."
          },
          "adotado": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string"
          },
          "detalhes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Requisição inválida: campos obrigatórios ausentes, valores inválidos ou id não numérico",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Dados inválidos.",
              "detalhes": [
                "O campo \"nome\" é obrigatório."
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "Pet não encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Pet não encontrado."
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Erro interno do servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Erro interno ao cadastrar pet."
            }
          }
        }
      }
    }
  }
}
